# === Bifrost Configuration ===

# Heimdall LLM Gateway
HEIMDALL_URL=http://localhost:8080
HEIMDALL_API_KEY=

# Bifrost Server
BIFROST_HOST=0.0.0.0
BIFROST_PORT=8100

# Database
DATABASE_PATH=data/bifrost.db

# Agent Execution Limits
MAX_ITERATIONS=10
MAX_EXECUTION_TIME=120

# Default LLM Model (via Heimdall)
DEFAULT_MODEL=qwen3.5

# Logging
LOG_LEVEL=INFO
