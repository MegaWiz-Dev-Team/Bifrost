# === Bifrost Configuration ===

# Heimdall LLM Gateway
HEIMDALL_URL=http://localhost:8080
HEIMDALL_API_KEY=

# Bifrost Server
BIFROST_HOST=0.0.0.0
BIFROST_PORT=8100

# Database
DATABASE_PATH=data/bifrost.db

# Mimir (RAG + Agent Builder)
MIMIR_URL=http://localhost:3000
MIMIR_API_KEY=
MIMIR_TENANT_ID=default

# MCP Sidecars (Rust)
YGGDRASIL_MCP_URL=http://localhost:8090/rpc
YGGDRASIL_MCP_ENABLED=true
EIR_MCP_URL=http://localhost:8091/rpc
EIR_MCP_ENABLED=true

# Agent Execution Limits
MAX_ITERATIONS=10
MAX_EXECUTION_TIME=120

# Default LLM Model (via Heimdall)
DEFAULT_MODEL=qwen3.5

# Logging
LOG_LEVEL=INFO
